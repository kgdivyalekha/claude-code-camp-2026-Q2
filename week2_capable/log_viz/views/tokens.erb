<% if !@ready %>
  <div class="no-data">
    <p>events.db not found. Run the agent with EventStore attached to generate token data.</p>
  </div>
<% else %>

<div class="tokens-dashboard">
  <div class="nav">
    <a href="/sessions/<%= @session.id %>">← Back to Transcript</a>
  </div>

  <div class="dashboard-header" id="dashboard-header">
    <h1>Token Baseline: <%= @session.id %></h1>
    <div class="live-indicator" id="live-indicator" style="display: none;">
      <span class="live-dot"></span>
      <span class="live-text">Live</span>
    </div>
  </div>

  <!-- Cost Summary -->
  <section class="cost-summary">
    <h2>Cost Summary</h2>
    <div class="metrics-grid">
      <div class="metric">
        <div class="label">Total Cost</div>
        <div class="value" data-cost-value="<%= @cost_summary[:total_usd] %>"><%= fmt_cost(@cost_summary[:total_usd]) %></div>
      </div>
      <div class="metric">
        <div class="label">Turns</div>
        <div class="value"><%= @cost_summary[:turns] %></div>
      </div>
      <div class="metric">
        <div class="label">Cost Per Turn</div>
        <div class="value"><%= fmt_cost(@cost_summary[:cost_per_turn_usd]) %></div>
      </div>
      <div class="metric">
        <div class="label">Total Input</div>
        <div class="value"><%= fmt_tokens(@cost_summary[:input_tokens]) %></div>
      </div>
      <div class="metric">
        <div class="label">Total Output</div>
        <div class="value"><%= fmt_tokens(@cost_summary[:output_tokens]) %></div>
      </div>
    </div>
  </section>

  <!-- Token Breakdown -->
  <section class="token-breakdown">
    <h2>Token Breakdown</h2>
    <p class="description">Estimated breakdown of where input tokens go (schema, history, results)</p>
    <div class="breakdown-bars">
      <div class="breakdown-row">
        <div class="breakdown-label">Schema</div>
        <div class="breakdown-bar">
          <div class="bar-segment schema" style="width: <%= @token_breakdown[:schema_tokens].to_f / @token_breakdown[:total_input_tokens] * 100 rescue 0 %>%">
            <%= fmt_tokens(@token_breakdown[:schema_tokens]) %>
          </div>
        </div>
      </div>
      <div class="breakdown-row">
        <div class="breakdown-label">History</div>
        <div class="breakdown-bar">
          <div class="bar-segment history" style="width: <%= @token_breakdown[:history_tokens].to_f / @token_breakdown[:total_input_tokens] * 100 rescue 0 %>%">
            <%= fmt_tokens(@token_breakdown[:history_tokens]) %>
          </div>
        </div>
      </div>
      <div class="breakdown-row">
        <div class="breakdown-label">Results</div>
        <div class="breakdown-bar">
          <div class="bar-segment results" style="width: <%= @token_breakdown[:result_tokens].to_f / @token_breakdown[:total_input_tokens] * 100 rescue 0 %>%">
            <%= fmt_tokens(@token_breakdown[:result_tokens]) %>
          </div>
        </div>
      </div>
      <div class="breakdown-row">
        <div class="breakdown-label">Output</div>
        <div class="breakdown-bar">
          <div class="bar-segment output" style="width: 100%">
            <%= fmt_tokens(@token_breakdown[:output_tokens]) %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema Overhead (§3.2 lever) -->
  <section class="schema-overhead">
    <h2>Schema Overhead (§3.2 — Tool Gating Lever)</h2>
    <p class="description">Tool definitions sent per call. Target: reduce from 26 to 7-10 by gating on game phase.</p>
    <div class="metrics-grid">
      <div class="metric">
        <div class="label">Tools Sent</div>
        <div class="value"><%= @schema_overhead[:tools_sent] %></div>
      </div>
      <div class="metric">
        <div class="label">Schema Tokens</div>
        <div class="value"><%= fmt_tokens(@schema_overhead[:schema_tokens]) %></div>
      </div>
      <div class="metric">
        <div class="label">Percent of Input</div>
        <div class="value"><%= @schema_overhead[:percent_of_input] %>%</div>
      </div>
    </div>
    <% if @schema_overhead[:percent_of_input] && @schema_overhead[:percent_of_input] > 25 %>
      <p class="callout">⚠ High schema overhead: gating tools by phase (M4) would reduce this.</p>
    <% end %>
  </section>

  <!-- Cache Effectiveness (§3.5 lever) -->
  <section class="cache-effectiveness">
    <h2>Cache Effectiveness (§3.5 — Prompt Caching Lever)</h2>
    <p class="description">Prompt cache hit rate. Target: ≥60% on sessions &gt; 20 turns.</p>
    <div class="metrics-grid">
      <div class="metric">
        <div class="label">Cache Hit Rate</div>
        <div class="value"><%= @cache_effectiveness[:hit_rate] %>%</div>
      </div>
      <div class="metric">
        <div class="label">Cache Read Tokens</div>
        <div class="value"><%= fmt_tokens(@cache_effectiveness[:cache_read_tokens]) %></div>
      </div>
      <div class="metric">
        <div class="label">Cache Write Tokens</div>
        <div class="value"><%= fmt_tokens(@cache_effectiveness[:cache_write_tokens]) %></div>
      </div>
    </div>
    <% if @cache_effectiveness[:hit_rate] && @cache_effectiveness[:hit_rate] < 10 %>
      <p class="callout">ℹ No cache hits yet. Enable prompt caching in config (M8).</p>
    <% end %>
  </section>

  <!-- M7 Compression Metrics (§3.3 lever) -->
  <% if @compression_metrics[:total_compressions] && @compression_metrics[:total_compressions] > 0 %>
    <section class="compression-metrics">
      <h2>M7 Compression (§3.3 — Result Compression Lever)</h2>
      <p class="description">Repeat-visit room compression: replace full descriptions with compact summaries.</p>
      <div class="metrics-grid">
        <div class="metric">
          <div class="label">Compressions Triggered</div>
          <div class="value"><%= @compression_metrics[:total_compressions] %></div>
        </div>
        <div class="metric">
          <div class="label">Total Tokens Saved</div>
          <div class="value"><%= fmt_tokens(@compression_metrics[:total_tokens_saved]) %></div>
        </div>
        <div class="metric">
          <div class="label">Avg Compression Ratio</div>
          <div class="value"><%= @compression_metrics[:average_compression_ratio] %>%</div>
        </div>
        <div class="metric">
          <div class="label">Avg Savings/Compression</div>
          <div class="value"><%= @compression_metrics[:average_savings_per_compression] %> tokens</div>
        </div>
      </div>

      <% if @compression_metrics[:compressions].any? %>
        <h3>Compression Details</h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>Room</th>
              <th>Tool</th>
              <th>Visit #</th>
              <th>Before</th>
              <th>After</th>
              <th>Saved</th>
              <th>Ratio</th>
            </tr>
          </thead>
          <tbody>
            <% @compression_metrics[:compressions].each do |comp| %>
              <tr>
                <td><code><%= comp[:room_id]&.slice(0, 12) %>…</code></td>
                <td><code><%= comp[:tool] %></code></td>
                <td><%= comp[:visit_count] %></td>
                <td><%= fmt_tokens(comp[:before_tokens]) %></td>
                <td><%= fmt_tokens(comp[:after_tokens]) %></td>
                <td><strong><%= fmt_tokens(comp[:saved_tokens]) %></strong></td>
                <td><span class="compression-ratio"><%= comp[:compression_ratio] %>%</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <p class="callout">✅ M7 compression active: room revisits compressed <%= @compression_metrics[:average_compression_ratio].round %>% on average.</p>
    </section>
  <% elsif @compression_metrics && @compression_metrics[:total_compressions] == 0 %>
    <section class="compression-metrics empty">
      <h2>M7 Compression (§3.3 — Result Compression Lever)</h2>
      <p class="description">Repeat-visit room compression would save tokens when rooms are revisited.</p>
      <p class="callout info">ℹ No compressions yet. Revisit rooms to trigger compression.</p>
    </section>
  <% end %>

  <!-- Tokens Per Turn -->
  <% if @tokens_per_turn.any? %>
    <section class="tokens-per-turn">
      <h2>Tokens Per Turn</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Turn</th>
            <th>Input</th>
            <th>Output</th>
            <th>Iterations</th>
            <th>Cost</th>
          </tr>
        </thead>
        <tbody>
          <% @tokens_per_turn.each do |row| %>
            <tr>
              <td><%= row["turn"] %></td>
              <td><%= fmt_tokens(row["input_tokens"]) %></td>
              <td><%= fmt_tokens(row["output_tokens"]) %></td>
              <td><%= row["iterations"] %></td>
              <td><%= fmt_cost(row["cost_usd"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <!-- Iteration Count (cost scales ~N×context) -->
  <% if @iterations_per_turn.any? %>
    <section class="iterations-per-turn">
      <h2>Iterations Per Turn</h2>
      <p class="description">Cost scales roughly N×context_size. Fewer iterations = cheaper turns.</p>
      <table class="data-table">
        <thead>
          <tr>
            <th>Turn</th>
            <th>Iterations</th>
            <th>Input Tokens</th>
          </tr>
        </thead>
        <tbody>
          <% @iterations_per_turn.each do |row| %>
            <tr>
              <td><%= row["turn"] %></td>
              <td><%= row["iterations"] %></td>
              <td><%= fmt_tokens(row["input_tokens"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <!-- Tool Usage -->
  <% if @tool_usage.any? %>
    <section class="tool-usage">
      <h2>Tool Usage</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Calls</th>
            <th>Success</th>
            <th>Errors</th>
          </tr>
        </thead>
        <tbody>
          <% @tool_usage.each do |row| %>
            <tr>
              <td><code><%= row["tool"] %></code></td>
              <td><%= row["call_count"] %></td>
              <td><%= row["success_count"] || 0 %></td>
              <td><%= row["error_count"] || 0 %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <!-- Summary -->
  <section class="summary">
    <h2>Baseline Summary</h2>
    <p>
      This is the token baseline for session <strong><%= @session.id %></strong>.
      Every optimization (M3–M8) will be measured against this to verify ≥50% reduction in tokens/room.
    </p>
    <p>
      Key metrics to watch:
    </p>
    <ul>
      <li><strong>Schema overhead</strong> (now <%= @schema_overhead[:percent_of_input] %>%) → Target &lt;10% with tool gating (M4)</li>
      <li><strong>Cache hit rate</strong> (now <%= @cache_effectiveness[:hit_rate] %>%) → Target ≥60% with prompt caching (M8)</li>
      <li><strong>Iterations/turn</strong> → Identify and fix loops that cause quadratic cost</li>
    </ul>
  </section>

</div>

<script>
  // Live refresh: check for new events every 2 seconds
  const sessionId = '<%= @session.id %>';
  let lastUpdate = Date.now();
  let noUpdateCount = 0;
  let previousCost = document.querySelector('[data-cost-value]')?.getAttribute('data-cost-value') || '0.0000';

  function formatCost(n) {
    if (!n || isNaN(n)) return '$0.0000';
    return '$' + parseFloat(n).toFixed(4);
  }

  function checkForUpdates() {
    fetch(`/api/sessions/${sessionId}/cost`)
      .then(response => {
        if (!response.ok) throw new Error('Not found');
        return response.json();
      })
      .then(data => {
        const newCost = formatCost(data.total_usd);
        const costElements = document.querySelectorAll('.cost-summary .metric .value');

        if (newCost !== previousCost && costElements.length > 0) {
          previousCost = newCost;
          lastUpdate = Date.now();
          noUpdateCount = 0;

          // Update the total cost display
          costElements[0].textContent = newCost;

          // Show update animation
          costElements[0].parentElement.style.animation = 'highlight-update 1s ease-out';
          setTimeout(() => {
            costElements[0].parentElement.style.animation = 'none';
          }, 1000);
        } else {
          noUpdateCount++;
        }
      })
      .catch(err => {
        console.log('Dashboard update check:', err);
        noUpdateCount++;
      });
  }

  // Show live indicator immediately
  document.getElementById('live-indicator').style.display = 'inline-flex';

  // Start polling every 2 seconds
  const refreshInterval = setInterval(checkForUpdates, 2000);

  // Add CSS for live indicator and updates
  const style = document.createElement('style');
  style.textContent = `
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .dashboard-header h1 {
      margin: 0;
      flex-grow: 1;
    }

    .live-indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
      animation: pulse-glow 2s ease-in-out infinite;
    }

    .live-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: white;
      border-radius: 50%;
      animation: pulse-blink 1s ease-in-out infinite;
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
      }
      50% {
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.6);
      }
    }

    @keyframes pulse-blink {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    @keyframes highlight-update {
      0% {
        background-color: #fef08a;
        box-shadow: 0 0 12px rgba(250, 204, 21, 0.5);
      }
      100% {
        background-color: transparent;
        box-shadow: none;
      }
    }

    /* M7 Compression metrics styling */
    .compression-metrics {
      border-left: 4px solid #8b5cf6;
    }

    .compression-metrics h3 {
      margin-top: 1.5rem;
      margin-bottom: 1rem;
      font-size: 1rem;
      color: #374151;
    }

    .compression-metrics.empty .callout.info {
      background-color: #e0e7ff;
      border-left-color: #6366f1;
      color: #3730a3;
    }

    .compression-ratio {
      background-color: #dbeafe;
      color: #0c4a6e;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.875rem;
    }

    .callout.info {
      background-color: #dbeafe;
      border-left-color: #0284c7;
      color: #0c4a6e;
    }

    @media (max-width: 768px) {
      .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .dashboard-header h1 {
        width: 100%;
      }

      .live-indicator {
        width: 100%;
        justify-content: center;
      }
    }
  `;
  document.head.appendChild(style);

  // Clean up on page unload
  window.addEventListener('beforeunload', () => {
    clearInterval(refreshInterval);
  });
</script>

<% end %>
