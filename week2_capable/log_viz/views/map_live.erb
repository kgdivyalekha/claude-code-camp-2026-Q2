<a href="/sessions/<%= @session.id %>" class="back">&larr; Session</a>

<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
  <div>
    <h1 style="margin: 0 0 0.5rem 0;">🗺️ World Map</h1>
    <p class="meta">Session <%= @session.id %> · <span id="room-count"><%= @room_count %></span> rooms · <span id="player-room">Loading...</span></p>
  </div>
  <div style="display: flex; gap: 1rem; align-items: center;">
    <button id="auto-refresh" style="
      padding: 0.6rem 1.2rem;
      border: 2px solid rgba(69, 183, 209, 0.6);
      background: rgba(20, 30, 50, 0.7);
      color: #e0e0e0;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.3s ease;
      backdrop-filter: blur(4px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    "
    onmouseover="this.style.boxShadow='0 0 12px rgba(69, 183, 209, 0.4)'; this.style.borderColor='rgba(69, 183, 209, 0.9)'"
    onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.2)'; this.style.borderColor='rgba(69, 183, 209, 0.6)'"
    >🔄 Auto-refresh: ON</button>
    <button id="theme-toggle" style="
      padding: 0.6rem 1.2rem;
      border: 2px solid rgba(255, 107, 107, 0.5);
      background: rgba(20, 30, 50, 0.7);
      color: #e0e0e0;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.3s ease;
      backdrop-filter: blur(4px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    "
    onmouseover="this.style.boxShadow='0 0 12px rgba(255, 107, 107, 0.3)'; this.style.borderColor='rgba(255, 107, 107, 0.8)'"
    onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.2)'; this.style.borderColor='rgba(255, 107, 107, 0.5)'"
    >☀️ Light</button>
    <a href="/sessions/<%= @session.id %>" style="color: var(--accent); text-decoration: none; font-weight: 500;">📋 Transcript</a>
    <a href="/sessions/<%= @session.id %>/tokens" style="color: var(--accent); text-decoration: none; font-weight: 500;">📊 Tokens</a>
  </div>
</div>

<% if @world_available && @rooms.any? %>
  <div style="position: relative; margin: 2rem 0;">
    <!-- Compass Rose -->
    <div style="
      position: absolute;
      top: 20px; right: 30px;
      width: 110px; height: 110px;
      background: rgba(20, 30, 50, 0.9);
      border: 3px solid rgba(255, 107, 107, 0.7);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      box-shadow: 0 0 20px rgba(255, 107, 107, 0.3), 0 0 40px rgba(69, 183, 209, 0.2), inset 0 0 15px rgba(255, 107, 107, 0.15);
      backdrop-filter: blur(8px);
    ">
      <div style="text-align: center; font-size: 14px; font-weight: 700; color: #FF6B6B; text-shadow: 0 0 8px rgba(255, 107, 107, 0.6), 0 0 2px rgba(0,0,0,0.5);">
        <div style="font-size: 18px; margin-bottom: 2px;">↑</div>
        <div style="font-size: 11px; margin-bottom: 4px;">NORTH</div>
        <div style="letter-spacing: 4px; margin: 4px 0; font-size: 12px; color: #45B7D1;">←   →</div>
        <div style="letter-spacing: 4px; font-size: 10px; color: rgba(255, 107, 107, 0.8);">W   E</div>
        <div style="font-size: 18px; margin-top: 2px; color: #FF6B6B;">↓</div>
      </div>
    </div>

    <!-- Map Canvas -->
    <div style="
      border: 2px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
      overflow: auto;
      width: 100%;
      height: 600px;
      position: relative;
    " id="map-container">
      <%
        # Calculate SVG dimensions based on room positions
        if @positions.any?
          max_x = @positions.values.map { |p| p[:x] }.max || 0
          max_y = @positions.values.map { |p| p[:y] }.max || 0
          svg_width = (max_x + 2) * 120 + 120  # Extra padding
          svg_height = (max_y + 2) * 120 + 120
        else
          svg_width = 1200
          svg_height = 675
        end
      %>
      <svg id="world-map-svg" width="<%= svg_width %>" height="<%= svg_height %>" style="display: block; background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); min-width: 100%; min-height: 100%;" data-light-bg="linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%)" data-dark-bg="linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%)">
        <defs>
          <marker id="arrowhead-blue" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="#45B7D1" />
          </marker>
          <marker id="arrowhead-red" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="#FF6B6B" />
          </marker>
          <marker id="arrowhead-yellow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="#FFD700" />
          </marker>
          <!-- Room gradients for visual depth -->
          <linearGradient id="room-grad-1" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#FF6B6B;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#CC5555;stop-opacity:0.9" />
          </linearGradient>
          <linearGradient id="room-grad-2" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#4ECDC4;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#3BA39C;stop-opacity:0.9" />
          </linearGradient>
          <linearGradient id="room-grad-3" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#45B7D1;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#3289A8;stop-opacity:0.9" />
          </linearGradient>
          <linearGradient id="room-grad-4" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#FFA07A;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#E67E5E;stop-opacity:0.9" />
          </linearGradient>
          <linearGradient id="room-grad-5" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#98D8C8;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#6DB8A8;stop-opacity:0.9" />
          </linearGradient>
          <style>
            .map-connection {
              stroke: rgba(69, 183, 209, 0.3);
              stroke-width: 2;
              fill: none;
              filter: drop-shadow(0 0 2px rgba(100, 150, 255, 0.3));
            }
            .map-arrow {
              stroke: #FF6B6B;
              stroke-width: 2.5;
              fill: none;
              stroke-dasharray: 5,5;
              filter: drop-shadow(0 0 3px rgba(255, 107, 107, 0.6));
            }
            .map-room-label {
              font-size: 12px;
              font-weight: 600;
              text-anchor: middle;
              dominant-baseline: middle;
              pointer-events: none;
              filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
            }
            .map-room-rect {
              cursor: pointer;
              transition: all 0.2s;
            }
            .map-room-rect:hover {
              filter: brightness(1.2) drop-shadow(0 0 8px rgba(255, 107, 107, 0.5));
              stroke-width: 3 !important;
            }
          </style>
        </defs>

        <!-- Draw connections between rooms (confirmed connections with target rooms) -->
        <% @rooms.each do |room| %>
          <% if @positions[room[:id]] %>
            <% from_pos = @positions[room[:id]] %>
            <% from_x = from_pos[:x] * 120 + 60 %>
            <% from_y = from_pos[:y] * 120 + 60 %>
            <% room[:exits].each do |direction, target_id| %>
              <% if target_id.to_s.strip != "" && @positions[target_id] %>
                <% to_pos = @positions[target_id] %>
                <% to_x = to_pos[:x] * 120 + 60 %>
                <% to_y = to_pos[:y] * 120 + 60 %>
                <line class="map-connection" x1="<%= from_x %>" y1="<%= from_y %>" x2="<%= to_x %>" y2="<%= to_y %>" marker-end="url(#arrowhead-blue)" />
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <!-- Draw rooms as small rectangles with gradients -->
        <% gradient_ids = ['room-grad-1', 'room-grad-2', 'room-grad-3', 'room-grad-4', 'room-grad-5'] %>
        <% @rooms.each_with_index do |room, idx| %>
          <% if @positions[room[:id]] %>
            <% pos = @positions[room[:id]] %>
            <% x = pos[:x] * 120 + 60 %>
            <% y = pos[:y] * 120 + 60 %>
            <% grad_id = gradient_ids[idx % gradient_ids.length] %>

            <!-- Room rectangle with gradient fill -->
            <rect class="map-room-rect"
                  id="room-<%= room[:id] %>"
                  data-room-id="<%= room[:id] %>"
                  data-room-name="<%= room[:name] %>"
                  data-room-desc="<%= (room[:description] || room[:summary] || 'No description available') %>"
                  data-room-visits="<%= room[:visit_count] %>"
                  x="<%= x - 45 %>" y="<%= y - 25 %>"
                  width="90" height="50"
                  rx="8" ry="8"
                  fill="url(#<%= grad_id %>)"
                  stroke="rgba(255, 255, 255, 0.3)"
                  stroke-width="2"
                  style="cursor: pointer;"
            >
              <title><%= room[:name] %></title>
            </rect>

            <!-- Room text (show first 12 chars with ellipsis if needed) -->
            <text class="map-room-label" x="<%= x %>" y="<%= y - 5 %>" font-size="11" font-weight="bold">
              <% display_name = room[:name].length > 12 ? room[:name][0, 12] + "…" : room[:name] %>
              <%= display_name %>
            </text>
            <text class="map-room-label" x="<%= x %>" y="<%= y + 10 %>" font-size="9" fill="rgba(255,255,255,0.7)">
              <%=  room[:visit_count] %>×
            </text>

            <!-- Direction indicators for all exits (traversed and untraversed) -->
            <% room[:exits].each do |direction, target_id| %>
              <% is_traversed = target_id.to_s.strip != "" %>
              <% arrow_offset = 50 %>
              <% dir_map = {
                'north' => [0, -arrow_offset, 'N'],
                'n' => [0, -arrow_offset, 'N'],
                'south' => [0, arrow_offset, 'S'],
                's' => [0, arrow_offset, 'S'],
                'east' => [arrow_offset, 0, 'E'],
                'e' => [arrow_offset, 0, 'E'],
                'west' => [-arrow_offset, 0, 'W'],
                'w' => [-arrow_offset, 0, 'W'],
                'northeast' => [arrow_offset*0.7, -arrow_offset*0.7, 'NE'],
                'ne' => [arrow_offset*0.7, -arrow_offset*0.7, 'NE'],
                'northwest' => [-arrow_offset*0.7, -arrow_offset*0.7, 'NW'],
                'nw' => [-arrow_offset*0.7, -arrow_offset*0.7, 'NW'],
                'southeast' => [arrow_offset*0.7, arrow_offset*0.7, 'SE'],
                'se' => [arrow_offset*0.7, arrow_offset*0.7, 'SE'],
                'southwest' => [-arrow_offset*0.7, arrow_offset*0.7, 'SW'],
                'sw' => [-arrow_offset*0.7, arrow_offset*0.7, 'SW'],
              } %>
              <% if dir_map[direction.downcase] %>
                <% dx, dy, label = dir_map[direction.downcase] %>
                <% if is_traversed %>
                  <!-- Confirmed exit with arrow line -->
                  <line class="map-arrow"
                        x1="<%= x %>" y1="<%= y %>"
                        x2="<%= x + dx*0.6 %>" y2="<%= y + dy*0.6 %>"
                        marker-end="url(#arrowhead-red)" stroke="#FF6B6B" />
                  <text class="map-room-label" x="<%= x + dx %>" y="<%= y + dy %>" font-size="10" fill="#FF6B6B" font-weight="bold">
                    <%= label %>
                  </text>
                <% else %>
                  <!-- Undiscovered exit - just a small indicator dot -->
                  <circle cx="<%= x + dx*0.35 %>" cy="<%= y + dy*0.35 %>" r="2.5" fill="rgba(255,165,0,0.5)" stroke="rgba(255,165,0,0.8)" stroke-width="0.5" />
                  <text class="map-room-label" x="<%= x + dx %>" y="<%= y + dy %>" font-size="9" fill="rgba(255,165,0,0.7)" font-weight="bold">
                    <%= label %>?
                  </text>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </svg>
    </div>

    <!-- Room Info Panel -->
    <div id="room-info-panel" style="
      position: absolute;
      bottom: 20px; left: 20px;
      background: rgba(20, 30, 50, 0.95);
      border: 2px solid rgba(255, 107, 107, 0.7);
      border-radius: 12px;
      padding: 1.4rem;
      min-width: 300px;
      max-width: 400px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 107, 107, 0.2), 0 0 20px rgba(255, 107, 107, 0.1);
      display: none;
      z-index: 20;
      backdrop-filter: blur(10px);
      color: #e0e0e0;
    ">
      <h3 id="room-name" style="margin: 0 0 1rem 0; color: #FF6B6B; font-size: 1.2rem; text-shadow: 0 0 6px rgba(255, 107, 107, 0.3); border-bottom: 2px solid rgba(255, 107, 107, 0.3); padding-bottom: 0.5rem;"></h3>
      <p id="room-desc" style="margin: 0.5rem 0 1.2rem 0; font-size: 0.9rem; color: #c0c0c0; line-height: 1.5; max-height: 100px; overflow-y: auto;"></p>
      <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(69, 183, 209, 0.4); font-size: 0.9rem;">
        <div style="margin: 0.4rem 0; color: #a8d5e8;">
          <strong style="color: #45B7D1;">🔍 Visits:</strong> <span id="room-visits" style="color: #e0e0e0;"></span>
        </div>
        <div style="margin: 0.4rem 0; color: #a8d5e8;">
          <strong style="color: #45B7D1;">🚪 Exits:</strong> <span id="room-exits" style="color: #e0e0e0;"></span>
        </div>
        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(69, 183, 209, 0.3); color: #888; font-size: 0.8rem;">
          💡 Click another room to navigate or explore unmapped exits (marked with ?)
        </div>
      </div>
    </div>
  </div>

<% else %>
  <div style="margin: 2rem 0; padding: 2rem; background: var(--bg-secondary); border-radius: 4px; text-align: center;">
    <h3 style="margin-top: 0;">🗺️ No Rooms Discovered Yet</h3>
    <p style="color: var(--text-secondary); margin: 0;">
      Start exploring to discover rooms. They'll appear here automatically.
    </p>
  </div>
<% end %>

<script>
  // Theme toggle (dark mode as default)
  const themeToggle = document.getElementById('theme-toggle');
  let isDarkMode = localStorage.getItem('mapTheme') !== 'light';  // Default to dark

  function updateSVGTheme(svg) {
    if (!svg) return;
    if (isDarkMode) {
      svg.style.background = `
        radial-gradient(circle at 20% 50%, rgba(255, 107, 107, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(69, 183, 209, 0.05) 0%, transparent 50%),
        linear-gradient(135deg, #0f1419 0%, #1a1f2e 100%)
      `;
    } else {
      svg.style.background = `
        radial-gradient(circle at 20% 50%, rgba(255, 107, 107, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(69, 183, 209, 0.08) 0%, transparent 50%),
        linear-gradient(135deg, #f8fafc 0%, #e8ecf1 100%)
      `;
    }
  }

  function applyTheme(dark) {
    isDarkMode = dark;
    localStorage.setItem('mapTheme', dark ? 'dark' : 'light');
    const svg = document.getElementById('world-map-svg');
    updateSVGTheme(svg);
    if (dark) {
      themeToggle.textContent = '☀️ Light';
      document.documentElement.style.setProperty('--map-text-color', '#ffffff');
    } else {
      themeToggle.textContent = '🌙 Dark';
      document.documentElement.style.setProperty('--map-text-color', '#333333');
    }
  }

  themeToggle.addEventListener('click', () => {
    applyTheme(!isDarkMode);
  });

  // Initialize theme (default to dark)
  applyTheme(isDarkMode);

  // Find and highlight player's current room from navigation_log
  const rooms = <%= @rooms.to_json %>;
  const currentRoomId = <%= @current_room_id.to_json %>;
  const positions = <%= @positions.to_json %>;

  function highlightPlayerPosition() {
    const svg = document.getElementById('world-map-svg');
    if (!rooms || rooms.length === 0 || !svg) return;

    // Remove existing player indicators
    const existingCircles = svg.querySelectorAll('.player-circle, .player-dot, .player-label, .player-arrow');
    existingCircles.forEach(el => el.remove());

    // Try to find by current_room_id from navigation_log, fall back to first room
    let currentRoom = null;
    if (currentRoomId) {
      currentRoom = rooms.find(r => r.id === currentRoomId);
    }
    if (!currentRoom) {
      currentRoom = rooms[0];
    }

    if (currentRoom && currentRoom.id) {
      document.getElementById('player-room').textContent = '📍 at ' + currentRoom.name;

      // Draw special arrows FROM player's current location
      if (currentRoom.exits && positions[currentRoom.id]) {
        const playerPos = positions[currentRoom.id];
        const playerX = playerPos.x * 120 + 60;
        const playerY = playerPos.y * 120 + 60;

        Object.entries(currentRoom.exits).forEach(([direction, targetId]) => {
          if (targetId && targetId.trim() !== '' && positions[targetId]) {
            const targetPos = positions[targetId];
            const targetX = targetPos.x * 120 + 60;
            const targetY = targetPos.y * 120 + 60;

            // Draw bright yellow arrow from player location
            const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            arrow.setAttribute('x1', playerX);
            arrow.setAttribute('y1', playerY);
            arrow.setAttribute('x2', targetX);
            arrow.setAttribute('y2', targetY);
            arrow.setAttribute('stroke', '#FFD700');
            arrow.setAttribute('stroke-width', '3.5');
            arrow.setAttribute('stroke-dasharray', '0');
            arrow.setAttribute('marker-end', 'url(#arrowhead-yellow)');
            arrow.setAttribute('opacity', '0.9');
            arrow.setAttribute('class', 'player-arrow');
            arrow.setAttribute('filter', 'drop-shadow(0 0 4px rgba(255, 215, 0, 0.8))');
            svg.insertBefore(arrow, svg.children[1]);
          }
        });
      }

      const playerRoomId = 'room-' + currentRoom.id;
      const playerRoomRect = document.getElementById(playerRoomId);

      if (playerRoomRect && positions[currentRoom.id]) {
        // Highlight the room box with stronger styling
        playerRoomRect.setAttribute('stroke', '#FF6B6B');
        playerRoomRect.setAttribute('stroke-width', '4');
        playerRoomRect.setAttribute('filter', 'drop-shadow(0 0 12px #FF6B6B)');
        playerRoomRect.style.opacity = '1.0';

        // Add player indicator circle
        const pos = positions[currentRoom.id];
        const x = pos.x * 120 + 60;
        const y = pos.y * 120 + 60;

        // Outer dashed circle
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', x);
        circle.setAttribute('cy', y);
        circle.setAttribute('r', '55');
        circle.setAttribute('fill', 'none');
        circle.setAttribute('stroke', '#FF6B6B');
        circle.setAttribute('stroke-width', '3');
        circle.setAttribute('stroke-dasharray', '8,4');
        circle.setAttribute('opacity', '0.7');
        circle.setAttribute('class', 'player-circle');
        svg.insertBefore(circle, svg.firstChild.nextSibling);

        // Inner solid circle
        const innerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        innerCircle.setAttribute('cx', x);
        innerCircle.setAttribute('cy', y);
        innerCircle.setAttribute('r', '8');
        innerCircle.setAttribute('fill', '#FF6B6B');
        innerCircle.setAttribute('class', 'player-dot');
        svg.appendChild(innerCircle);

        // Label: YOU ARE HERE
        const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        label.setAttribute('x', x);
        label.setAttribute('y', y - 70);
        label.setAttribute('text-anchor', 'middle');
        label.setAttribute('fill', '#FF6B6B');
        label.setAttribute('font-weight', 'bold');
        label.setAttribute('font-size', '14');
        label.setAttribute('filter', 'drop-shadow(0 0 4px rgba(0,0,0,0.8))');
        label.setAttribute('class', 'player-label');
        label.textContent = '📍 YOU ARE HERE';
        svg.appendChild(label);
      } else if (playerRoomRect) {
        // Room rect exists but no position - still highlight it
        playerRoomRect.setAttribute('stroke', '#FF6B6B');
        playerRoomRect.setAttribute('stroke-width', '3');
        playerRoomRect.setAttribute('filter', 'drop-shadow(0 0 8px #FF6B6B)');
      }
    }
  }

  // Initial highlight
  highlightPlayerPosition();

  function showRoomInfo(id, name, desc) {
    document.getElementById('room-name').textContent = name;
    document.getElementById('room-desc').textContent = desc;

    const room = rooms.find(r => r.id === id);
    if (room) {
      const exitCount = room.exits ? Object.keys(room.exits).length : 0;
      document.getElementById('room-visits').textContent = room.visit_count + ' time' + (room.visit_count === 1 ? '' : 's');
      document.getElementById('room-exits').textContent = exitCount + ' exit' + (exitCount === 1 ? '' : 's');

      // Show exit directions
      if (room.exits && Object.keys(room.exits).length > 0) {
        const exitDirs = Object.keys(room.exits).sort().join(', ').toUpperCase();
        document.getElementById('room-exits').textContent += ' (' + exitDirs + ')';
      }
    }

    document.getElementById('room-info-panel').style.display = 'block';
  }

  // Initial click handlers
  attachRoomClickHandlers();

  // Helper function to attach click handlers to room rectangles
  function attachRoomClickHandlers() {
    const roomRects = document.querySelectorAll('.map-room-rect');
    roomRects.forEach(rect => {
      rect.removeEventListener('click', handleRoomClick);  // Remove old listener
      rect.addEventListener('click', handleRoomClick);
    });
  }

  function handleRoomClick(e) {
    const rect = e.target;
    const id = rect.getAttribute('data-room-id');
    const name = rect.getAttribute('data-room-name');
    const desc = rect.getAttribute('data-room-desc');
    showRoomInfo(id, name, desc);
    e.stopPropagation();
  }

  // Auto-refresh map as agent explores (preserve scroll position with AJAX)
  const autoRefreshBtn = document.getElementById('auto-refresh');
  let refreshInterval;
  let isAutoRefreshOn = true;
  const mapContainer = document.getElementById('map-container');

  function startAutoRefresh() {
    if (refreshInterval) clearInterval(refreshInterval);
    refreshInterval = setInterval(() => {
      // Save scroll position before refresh
      if (mapContainer) {
        sessionStorage.setItem('mapScrollX', mapContainer.scrollLeft);
        sessionStorage.setItem('mapScrollY', mapContainer.scrollTop);
      }

      // Use AJAX to avoid full page reload (keeps scroll position)
      fetch(window.location.href)
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const newDoc = parser.parseFromString(html, 'text/html');
          const newSVG = newDoc.getElementById('world-map-svg');
          const oldSVG = document.getElementById('world-map-svg');

          if (newSVG && oldSVG) {
            // Replace the SVG element
            oldSVG.parentElement.replaceChild(newSVG, oldSVG);

            // Update room count display
            const newCount = newDoc.getElementById('room-count');
            const oldCount = document.getElementById('room-count');
            if (newCount && oldCount) {
              oldCount.textContent = newCount.textContent;
            }

            // Update player room display
            const newPlayer = newDoc.getElementById('player-room');
            const oldPlayer = document.getElementById('player-room');
            if (newPlayer && oldPlayer) {
              oldPlayer.textContent = newPlayer.textContent;
            }

            // Apply current theme to new SVG
            updateSVGTheme(newSVG);

            // Re-highlight player position
            highlightPlayerPosition();

            // Restore scroll position
            if (mapContainer) {
              const x = sessionStorage.getItem('mapScrollX');
              const y = sessionStorage.getItem('mapScrollY');
              if (x !== null) mapContainer.scrollLeft = parseInt(x);
              if (y !== null) mapContainer.scrollTop = parseInt(y);
            }

            // Re-attach click handlers to new SVG elements
            attachRoomClickHandlers();
          }
        })
        .catch(err => {
          console.error('Map refresh error:', err);
          // Fallback to full reload on error
          location.reload();
        });
    }, 3000);  // Refresh every 3 seconds
  }

  function stopAutoRefresh() {
    if (refreshInterval) clearInterval(refreshInterval);
  }

  function updateAutoRefreshBtn() {
    if (isAutoRefreshOn) {
      autoRefreshBtn.textContent = '🔄 Auto-refresh: ON';
      autoRefreshBtn.style.borderColor = 'rgba(69, 183, 209, 0.6)';
      startAutoRefresh();
    } else {
      autoRefreshBtn.textContent = '🔄 Auto-refresh: OFF';
      autoRefreshBtn.style.borderColor = 'rgba(255, 107, 107, 0.6)';
      stopAutoRefresh();
    }
  }

  autoRefreshBtn.addEventListener('click', () => {
    isAutoRefreshOn = !isAutoRefreshOn;
    updateAutoRefreshBtn();
  });

  // Restore scroll position on initial page load
  window.addEventListener('load', () => {
    if (mapContainer) {
      const x = sessionStorage.getItem('mapScrollX');
      const y = sessionStorage.getItem('mapScrollY');
      if (x !== null) mapContainer.scrollLeft = parseInt(x);
      if (y !== null) mapContainer.scrollTop = parseInt(y);
    }
  });

  // Start auto-refresh on page load
  startAutoRefresh();

  // Trigger ANSI cleanup on page load (but don't reload)
  window.addEventListener('load', () => {
    fetch('/sessions/<%= @session.id %>/map/clean-ansi')
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          console.log('✓ ANSI codes cleaned from database');
        }
      })
      .catch(err => {
        console.log('ANSI cleanup skipped:', err.message);
      });
  }, { once: true });

  // Legend for map symbols
  window.addEventListener('load', () => {
    const legend = document.createElement('div');
    legend.style.cssText = `
      position: absolute;
      top: 20px; left: 20px;
      background: rgba(20, 30, 50, 0.85);
      border: 2px solid rgba(69, 183, 209, 0.6);
      border-radius: 12px;
      padding: 1rem;
      z-index: 15;
      backdrop-filter: blur(4px);
      font-size: 0.85rem;
      color: #b0b0b0;
      min-width: 200px;
    `;
    legend.innerHTML = `
      <h4 style="margin: 0 0 0.8rem 0; color: #45B7D1; font-size: 0.95rem;">🧭 Map Legend</h4>
      <div style="line-height: 1.6;">
        <div><span style="color: #FF6B6B;">━━</span> Red arrow = traversed exit</div>
        <div><span style="color: rgba(255,165,0,0.8);">● ?</span> Orange = undiscovered</div>
        <div><span style="color: #FF6B6B;">◯ YOU ARE HERE</span> = player location</div>
        <div style="color: #999; font-size: 0.8rem; margin-top: 0.5rem;">Click rooms for details</div>
      </div>
    `;
    const mapContainer = document.querySelector('[style*="border-radius: 8px"]');
    if (mapContainer && mapContainer.parentElement) {
      mapContainer.parentElement.appendChild(legend);
    }
  }, { once: true });
</script>
